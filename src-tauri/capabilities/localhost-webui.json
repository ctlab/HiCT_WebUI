{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "localhost-webui",
  "description": "Allow the local HiCT WebUI served by HiCT_JVM to call the small Tauri wrapper quit command.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://127.0.0.1:*",
      "http://[::1]:*"
    ]
  },
  "permissions": ["allow-quit-app"]
}
