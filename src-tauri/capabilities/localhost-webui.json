{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "localhost-webui",
  "description": "Allow the local HiCT WebUI served by HiCT_JVM to call the small Tauri wrapper commands.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "permissions": ["allow-quit-app", "allow-save-export"]
}
